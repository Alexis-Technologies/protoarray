{
  "name": "@alexify/protoarray",
  "version": "1.0.0",
  "description": "Zero-dependency schema-based compact serialization for Node.js and browsers: objects travel as positional JSON arrays, a shared schema maps every position back to its key. A lightweight alternative to Protocol Buffers",
  "license": "MIT",
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/protoarray.git"
  },
  "homepage": "https://protoarray.vercel.app/",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/protoarray/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 98 --statements 98 --branches 90 --functions 100 --reporter text --reporter lcov node --test tests/unit/*.test.js",
    "test:types": "tsd",
    "check:dts": "tsc --noEmit --strict --target es2022 --skipLibCheck false index.d.ts",
    "lint": "oxlint src tests scripts bench",
    "format": "oxfmt src tests scripts bench",
    "format:check": "oxfmt --check src tests scripts bench",
    "size": "node scripts/size.js",
    "bench": "node bench/bench.js",
    "bench:compare": "node bench/compare.js",
    "bench:report": "node bench/report.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run test:types && pnpm run check:dts",
    "release": "pnpm publish"
  },
  "tsd": {
    "directory": "tests/types"
  },
  "keywords": [
    "array",
    "binary-alternative",
    "browser",
    "codec",
    "columnar",
    "compact",
    "encoding",
    "json",
    "msgpack",
    "payload",
    "positional",
    "protoarray",
    "protobuf",
    "protocol-buffers",
    "schema",
    "schema-evolution",
    "serialization",
    "sparse",
    "zero-dependency"
  ],
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "avsc": "^5.7.9",
    "c8": "^12.0.0",
    "cbor-x": "^1.6.6",
    "esbuild": "^0.28.2",
    "fast-json-stringify": "^7.0.1",
    "msgpackr": "^2.1.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.75.0",
    "protobufjs": "^8.8.0",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  }
}
